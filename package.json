{
  "name": "wireframes",
  "version": "0.1.2",
  "description": "Component library for building wireframes and prototypes",
  "keywords": [
    "wireframe",
    "ui",
    "design",
    "components",
    "javascript",
    "typescript",
    "react",
    "vue"
  ],
  "author": "salteadorneo",
  "license": "BSD-3-Clause",
  "homepage": "https://wireframes.salteadorneo.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salteadorneo/wireframes.git"
  },
  "bugs": {
    "url": "https://github.com/salteadorneo/wireframes/issues",
    "email": "wireframes@salteadorneo.dev"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "unpkg": "lib/index.js",
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "lib/package.json",
    "!lib/*.test.js"
  ],
  "scripts": {
    "docs": "node scripts/docs.mjs",
    "docs:check": "node scripts/docs.mjs --check",
    "build": "cd packages/cdn && npm i && npm run build && cd ../.. && node scripts/docs.mjs && node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node scripts/docs.mjs --check && node --test lib/wf.test.js",
    "tailwind": "npx tailwindcss -i ./src/directives.css -o ./www/tailwind.css --watch"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "puppeteer": "25.12.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./loader": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./react": {
      "types": "./lib/react.d.ts"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "sideEffects": true
}
